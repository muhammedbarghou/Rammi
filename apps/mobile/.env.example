# Copy to apps/mobile/.env. EXPO_PUBLIC_ values are bundled into the app, so never put a secret here.
EXPO_PUBLIC_SUPABASE_URL=https://oprycruewxlvcbeiykmv.supabase.co
# Dashboard > Project Settings > API Keys > Publishable key (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The Colyseus server, reachable from the phone, for example ws://192.168.1.20:2567
EXPO_PUBLIC_SERVER_URL=
# Google Cloud OAuth client ids. The web client id is also set in Supabase > Auth > Providers > Google.
# Android also needs an Android OAuth client (package com.rami.talaj71 plus the signing SHA-1); its id is not set here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# The iOS client id reversed: com.googleusercontent.apps.<id>. Read at build time by app.config.ts. Leave empty until the iOS client exists.
GOOGLE_IOS_URL_SCHEME=
